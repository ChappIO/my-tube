{
  "name": "@mytube/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "PORT=${API_PORT:-8080} CONFIG_DIR=${CONFIG_DIR:-../../.local/config} MUSIC_DIR=${MUSIC_DIR:-../../.local/music} VIDEO_DIR=${VIDEO_DIR:-../../.local/video} nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mytube/shared": "workspace:*",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/schedule": "12.0.2",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.6",
    "@nestjs/testing": "12.1.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
