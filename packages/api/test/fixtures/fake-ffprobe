#!/usr/bin/env node
// A stand-in for ffprobe in tests. Point FFPROBE_PATH at this file. The "media file" a test
// writes is the probe itself: a file whose content is ffprobe's JSON (`{"streams": [...],
// "format": {...}}`) is printed as is; anything else fails like real ffprobe does on a file it
// cannot read ("Invalid data found when processing input", exit 1).
//
// Environment:
//   FAKE_FFPROBE_LOG=<path>     append one line per run (the probed path), to count the runs
import { appendFileSync, readFileSync } from 'node:fs';

const args = process.argv.slice(2);
const file = args.at(-1) ?? '';
if (process.env.FAKE_FFPROBE_LOG) appendFileSync(process.env.FAKE_FFPROBE_LOG, `${file}\n`);

let text = '';
try {
  text = readFileSync(file, 'utf8');
} catch {
  process.stderr.write(`${file}: No such file or directory\n`);
  process.exit(1);
}
try {
  const probe = JSON.parse(text);
  if (!probe || typeof probe !== 'object' || !Array.isArray(probe.streams)) throw new Error();
  process.stdout.write(JSON.stringify(probe, null, 2));
} catch {
  process.stderr.write(`${file}: Invalid data found when processing input\n`);
  process.exit(1);
}
