{
  "name": "mytube",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @mytube/shared build && pnpm --filter @mytube/api dev",
    "dev:web": "pnpm --filter @mytube/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @mytube/api start",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test",
    "lint:infra": "actionlint && hadolint Dockerfile && shellcheck docker/entrypoint.sh"
  },
  "devDependencies": {
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@12.6.0"
}
