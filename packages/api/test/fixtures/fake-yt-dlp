#!/usr/bin/env node
// A stand-in for the yt-dlp binary in tests. Point YTDLP_PATH (or a YtdlpBinaryLocator) at
// this file. It never touches the network and mimics the output shapes the real binary
// produces for the arguments YtdlpRunner builds.
//
//   --version                   prints FAKE_YTDLP_VERSION (default 2026.08.19)
//   --dump-single-json <url>    prints a fixture from ./ytdlp: playlist.json for list= URLs,
//                               video.json for watch?v= URLs, channel.json otherwise;
//                               FAKE_YTDLP_FIXTURE overrides with a path. Music (./ytdlp/music):
//                               releases.json for /releases, uploads.json for /channel/<id>/videos,
//                               list-<id>.json for a list= URL when it exists, track.json for
//                               music.youtube.com/watch?v= URLs
//   -x --audio-format <ext>     a download writes <output>.<ext> instead of .mp4
//   anything else               a download: progress lines on stdout, post-processor lines
//                               on stderr, then the final file path; creates the file
//
// Environment:
//   FAKE_YTDLP_FAIL=1           print an ERROR line to stderr and exit 1
//   FAKE_YTDLP_EXIT=<code>      exit code used with FAKE_YTDLP_FAIL (default 1)
//   FAKE_YTDLP_DELAY_MS=<ms>    delay before each progress line (and before the JSON)
//   FAKE_YTDLP_STDOUT=<text>    print this instead of a fixture for --dump-single-json
//   FAKE_YTDLP_ARGS_FILE=<path> write the received argv as JSON to this file
//   FAKE_YTDLP_STREAMS=split    a download as a merged video: subtitles, thumbnail conversion,
//                               a video and an audio stream, then four post-processors
//   FAKE_YTDLP_NO_RELEASES=1    a /releases URL fails like a channel without that tab
//   FAKE_YTDLP_FORMAT_ERROR=<when>  metadata and download calls fail with `Requested format is not
//                               available`: `always`, `cookies` (only with --cookies, the
//                               PO-token loss of a signed-in session) or `probe` (only a
//                               --dump-single-json call with -f)
//   FAKE_YTDLP_BOT_CHECK=1      every call without --cookies fails with the bot check
//   FAKE_YTDLP_FORMATS=<table>  what -F prints: `table` (default: a PO-token warning, storyboards
//                               and audio formats), `storyboards` (the warning and storyboards
//                               only) or `none` (no formats at all: yt-dlp's `No video formats found!`)
import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';

const args = process.argv.slice(2);
const env = process.env;
const delay = Number(env.FAKE_YTDLP_DELAY_MS ?? 0);
const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
const fixtures = join(import.meta.dirname, 'ytdlp');
const musicFixtures = join(fixtures, 'music');

if (env.FAKE_YTDLP_ARGS_FILE) writeFileSync(env.FAKE_YTDLP_ARGS_FILE, JSON.stringify(args));

const option = (name) => {
  const index = args.indexOf(name);
  return index === -1 ? undefined : args[index + 1];
};
const url = args[args.indexOf('--') + 1] ?? '';

if (args.includes('--version')) {
  process.stdout.write(`${env.FAKE_YTDLP_VERSION ?? '2026.08.19'}\n`);
  process.exit(0);
}

const videoId = url.split('=').pop();
const cookies = args.includes('--cookies');

if (env.FAKE_YTDLP_BOT_CHECK && !cookies) {
  process.stderr.write(
    `ERROR: [youtube] ${videoId}: Sign in to confirm you’re not a bot. Use --cookies-from-browser or --cookies for the authentication. See  https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp  for how to manually pass cookies. Also see  https://github.com/yt-dlp/yt-dlp/wiki/Extractors#exporting-youtube-cookies  for tips on effectively exporting YouTube cookies\n`,
  );
  process.exit(1);
}

if (args.includes('-F')) {
  // The shapes yt-dlp 2026.08.19 prints for `-F` (warnings on).
  const mode = env.FAKE_YTDLP_FORMATS ?? 'table';
  if (mode === 'none') {
    process.stdout.write(`[youtube] Extracting URL: ${url}\n`);
    process.stderr.write(
      `WARNING: [youtube] ${videoId}: Only images are available for download. use --list-formats to see them\n`,
    );
    process.stderr.write(
      `ERROR: [youtube] ${videoId}: No video formats found!; please report this issue on  https://github.com/yt-dlp/yt-dlp/issues\n`,
    );
    process.exit(1);
  }
  process.stdout.write(`[youtube] Extracting URL: ${url}\n`);
  process.stderr.write(
    `WARNING: [youtube] ${videoId}: Some web client https formats have been skipped as they are missing a url. YouTube is forcing SABR streaming for this client. See  https://github.com/yt-dlp/yt-dlp/issues/12482  for more details\n`,
  );
  process.stdout.write(
    [
      `[info] Available formats for ${videoId}:`,
      'ID  EXT   RESOLUTION FPS CH │   FILESIZE   TBR PROTO │ VCODEC  VBR ACODEC      ABR ASR MORE INFO',
      '─'.repeat(100),
      'sb2 mhtml 48x27        0    │                  mhtml │ images                      storyboard',
      'sb1 mhtml 80x45        0    │                  mhtml │ images                      storyboard',
      ...(mode === 'storyboards'
        ? []
        : [
            '139 m4a   audio only      2 │    1.19MiB   49k https │ audio only     mp4a.40.5   49k 22k low, m4a_dash',
            '140 m4a   audio only      2 │    3.16MiB  129k https │ audio only     mp4a.40.2  129k 44k medium, m4a_dash',
            '251 webm  audio only      2 │    3.30MiB  135k https │ audio only     opus       135k 48k medium, webm_dash',
          ]),
      '',
    ].join('\n'),
  );
  process.exit(0);
}

const formatError = env.FAKE_YTDLP_FORMAT_ERROR;
if (
  formatError &&
  (formatError === 'always' ||
    (formatError === 'cookies' && cookies) ||
    (formatError === 'probe' && args.includes('--dump-single-json') && args.includes('-f')))
) {
  process.stderr.write(
    `ERROR: [youtube] ${videoId}: Requested format is not available. Use --list-formats for a list of available formats\n`,
  );
  process.exit(1);
}

if (env.FAKE_YTDLP_FAIL) {
  await sleep(delay);
  process.stderr.write('WARNING: [youtube] Falling back to generic n function search\n');
  process.stderr.write(`ERROR: [youtube] ${url.split('=').pop()}: Video unavailable\n`);
  process.exit(Number(env.FAKE_YTDLP_EXIT ?? 1));
}

/** A music fixture for the URL, or undefined for the video ones. */
function musicFixture() {
  if (url.includes('/releases')) return join(musicFixtures, 'releases.json');
  if (/\/channel\/[^/]+\/videos$/.test(url)) return join(musicFixtures, 'uploads.json');
  if (url.includes('music.youtube.com/watch?v=')) return join(musicFixtures, 'track.json');
  const list = /[?&]list=([^&]+)/.exec(url)?.[1];
  const listFile = list && join(musicFixtures, `list-${list}.json`);
  return listFile && existsSync(listFile) ? listFile : undefined;
}

if (args.includes('--dump-single-json')) {
  await sleep(delay);
  if (env.FAKE_YTDLP_NO_RELEASES && url.includes('/releases')) {
    process.stderr.write(`ERROR: [youtube:tab] ${url}: This channel does not have a releases tab\n`);
    process.exit(1);
  }
  if (env.FAKE_YTDLP_STDOUT !== undefined) {
    process.stdout.write(env.FAKE_YTDLP_STDOUT);
  } else {
    const name = url.includes('list=')
      ? 'playlist.json'
      : url.includes('watch?v=')
        ? 'video.json'
        : 'channel.json';
    process.stdout.write(
      readFileSync(env.FAKE_YTDLP_FIXTURE ?? musicFixture() ?? join(fixtures, name)),
    );
  }
  process.exit(0);
}

// Download. The same line shapes the real binary prints with the runner's templates.
const id = url.split('=').pop() || 'fake';
const ext = args.includes('-x') ? (option('--audio-format') ?? 'm4a') : 'mp4';
const output = (option('-o') ?? '%(id)s.%(ext)s')
  .replaceAll('%(id)s', id)
  .replaceAll('%(title)s', 'Fake video')
  .replaceAll('%(ext)s', ext)
  .replaceAll('%%', '%');
const progress = (formatId, fields) =>
  process.stdout.write(
    `[mytube-progress] ${JSON.stringify({ format_id: formatId, progress: fields })}\n`,
  );
// Post-processor lines go to stderr and progress lines to stdout, as with the real binary. The
// runner reads the two pipes separately, so a short pause on either side of a post-processor
// keeps the order the test expects on a busy machine (without it a later stdout line can be
// read before the stderr line written first).
const PIPE_SETTLE_MS = 15;
const postprocess = async (name) => {
  await sleep(PIPE_SETTLE_MS);
  for (const status of ['started', 'finished']) {
    process.stderr.write(`[mytube-progress] {"status": "${status}", "postprocessor": "${name}"}\n`);
  }
  await sleep(PIPE_SETTLE_MS);
};
// One stream: its total is known from the first line. yt-dlp learns a stream's size only when
// that stream starts, so a second stream's total is not in the first stream's lines.
const stream = async (formatId, total, steps) => {
  for (const downloaded of steps) {
    await sleep(delay);
    progress(formatId, {
      status: 'downloading',
      downloaded_bytes: downloaded,
      total_bytes: total,
      speed: 1048576.5,
      eta: Math.ceil((total - downloaded) / 1048576),
    });
  }
  progress(formatId, {
    status: 'finished',
    downloaded_bytes: total,
    total_bytes: total,
    speed: 1048576.5,
  });
};

if (env.FAKE_YTDLP_STREAMS === 'split') {
  // What a merged download with subtitles and a thumbnail prints (yt-dlp 2026.08.19): the
  // subtitle track (no format id), the thumbnail conversion, the video stream, the audio
  // stream, then the post-processors. Sizes match requested_formats in video.json.
  progress('', { status: 'finished', downloaded_bytes: 1642, total_bytes: 1642 });
  await postprocess('ThumbnailsConvertor');
  await stream('248', 2400000, [1024, 600000, 1200000, 1800000, 2400000]);
  await stream('251', 600000, [1024, 150000, 300000, 450000, 600000]);
  for (const name of ['Merger', 'VideoRemuxer', 'EmbedSubtitle', 'MoveFiles']) {
    await sleep(delay);
    await postprocess(name);
  }
} else {
  await stream('18', 3000000, [1024, 750000, 1500000, 3000000]);
  await postprocess('MoveFiles');
}
mkdirSync(dirname(output), { recursive: true });
writeFileSync(output, 'fake media');
process.stdout.write(`[mytube-file] ${output}\n`);
